<!--
  The bar of tabs along the bottom of every page.
  `active` says which tab to highlight: home, daily, puzzles or wager.
-->
<nav webc:root="override" aria-label="Game modes">
  <a
    href="/"
    :class="active === 'home' ? 'active' : ''"
    :aria-current="active === 'home' ? 'page' : false"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 11 12 3l9 8" />
      <path d="M5 10v10h14V10" />
    </svg>
    Home
  </a>
  <a
    href="/daily/"
    :class="active === 'daily' ? 'active' : ''"
    :aria-current="active === 'daily' ? 'page' : false"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <path d="M3 10h18M8 3v4M16 3v4" />
    </svg>
    Daily
  </a>
  <a
    href="/puzzles/"
    :class="active === 'puzzles' ? 'active' : ''"
    :aria-current="active === 'puzzles' ? 'page' : false"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2.5 20.2 7.25v9.5L12 21.5l-8.2-4.75v-9.5Z" />
    </svg>
    Puzzles
  </a>
  <a
    href="/wager/"
    :class="active === 'wager' ? 'active' : ''"
    :aria-current="active === 'wager' ? 'page' : false"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M14.5 9h-3.5a1.75 1.75 0 0 0 0 3.5h2a1.75 1.75 0 0 1 0 3.5H9.5M12 7v2M12 16v1.5" />
    </svg>
    Wager
  </a>
</nav>

<style webc:scoped>
  :host {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--bg);
    border-top: 1px solid var(--tile);
    padding-bottom: env(safe-area-inset-bottom);
  }

  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.6rem 0 0.7rem;
    font-size: 0.75rem;
    color: var(--line);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  a.active {
    color: var(--yellow);
  }

  svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>

<!-- Not scoped: makes room at the bottom of every page so the bar never covers anything -->
<style>
  body {
    padding-bottom: calc(5rem + env(safe-area-inset-bottom));
  }
</style>
