<div webc:root="override">
  <template
    x-for="(letter, idx) in $store.game.outerLetters"
    webc:keep
    x-bind:key="`${letter}_${idx}`"
  >
    <div class="outer letter">
      <button x-data="letterButton(letter)" x-bind="tmpl">
        <span class="hex" x-text="letter"></span>
      </button>
    </div>
  </template>
  <div class="center letter">
    <button
      x-data="letterButton($store.game.centerLetter)"
      x-effect="letter = $store.game.centerLetter"
      x-bind="tmpl"
    >
      <span class="hex gradient-bg" x-text="letter"></span>
    </button>
  </div>
</div>
<script webc:bucket="alpine">
  Alpine.data("letterButton", (letter) => ({
    letter,
    pressed: false,
    // Each letter keeps its own timer (declared here so it isn't shared)
    pressTimer: null,
    // The letter is added the moment a finger (or mouse button) goes down,
    // so lifting or sliding a little can't cancel it
    press(event) {
      if (event.button !== 0) return;
      event.preventDefault();
      this.guess += this.letter;
      // Brief "pressed" look, since the browser's own :active style
      // doesn't show reliably once the touch is handled this way
      this.pressed = true;
      clearTimeout(this.pressTimer);
      this.pressTimer = setTimeout(() => (this.pressed = false), 120);
    },
    tmpl: {
      type: "button",
      "@pointerdown": "press($event)",
      ":class": "{ pressed }",
      // Hiding these buttons from screen readers because they will just be noisy and hard to navigate;
      // if using the keyboard, the user will be expected to type their guess into the text input
      // instead of clicking these buttons.
      tabindex: "-1",
      "aria-hidden": "true",
    },
  }));
</script>
<style webc:scoped>
  :host {
    /* Less space around the letters on short phones */
    margin: clamp(0.5rem, 3dvh, 2rem) auto;
    display: block;
    position: relative;
    /* Fits the width, and on short phones the height too */
    /* The board's size: 60% of the width, at most about a third of the
       height, and smaller still if the screen is short on room once the
       header, guess, and buttons (which grow with text size) are in. */
    --button-wrapper-size: min(60vw, 32dvh, max(42vw, 94dvh - 29rem));
    --button-wrapper-max-size: 20rem;
    width: var(--button-wrapper-size);
    max-width: var(--button-wrapper-max-size);
    aspect-ratio: 1;

    /* Button widths are the wrapper's width / 2.5 */
    --button-size: calc(var(--button-wrapper-size) / 2.5);
    --button-max-size: 8rem;
  }

  .letter {
    position: absolute;
    top: 50%;
    left: 50%;
    --translate-x: -50%;
    --translate-y: -50%;
    transform: translate(var(--translate-x), var(--translate-y));
  }

  /* The button is the touch target: a full-size hexagon, so the letters
     meet edge to edge with no gaps for a tap to fall into */
  button {
    display: block;
    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
    background: none;
    border: none;

    width: var(--button-size);
    max-width: var(--button-max-size);
    aspect-ratio: 1.15;
  }

  /* The hexagon you see sits inside it, a little smaller. Only this part
     shrinks when pressed, so the touch target never moves */
  .hex {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
    font-weight: 600;
    font-size: 2.2rem;
    text-transform: uppercase;

    --scale: 0.925;
    transform: scale(var(--scale));

    transition-property: transform, opacity;
    transition-duration: 0.12s;
  }

  button.pressed .hex {
    --scale: 0.85;
    opacity: 0.8;
  }

  .outer.letter .hex {
    background: var(--gray);
  }

  .outer.letter:nth-of-type(1) {
    --translate-y: -150%;
  }

  .outer.letter:nth-of-type(2) {
    --translate-x: -125%;
    --translate-y: -100%;
  }

  .outer.letter:nth-of-type(3) {
    --translate-x: 25%;
    --translate-y: -100%;
  }

  .outer.letter:nth-of-type(4) {
    --translate-x: -125%;
    --translate-y: 0%;
  }

  .outer.letter:nth-of-type(5) {
    --translate-x: 25%;
    --translate-y: 0%;
  }

  .outer.letter:nth-of-type(6) {
    --translate-y: 50%;
  }
</style>
