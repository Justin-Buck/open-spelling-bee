---
layout: base.webc
title: What is this?
tab: home
---

<!--
  Buzz explains the game, one speech bubble at a time.
  The words live in src/_data/buzzTalk.json: edit them there, not here.
-->
<main
  class="about"
  x-data="buzzTalk"
  x-cloak
  x-on:click.window="next($event)"
  x-on:keydown.window.enter="next()"
  x-on:keydown.window.space.prevent="next()"
>
  <h1>What is this?</h1>

  <div class="bubble" aria-live="polite">
    <p
      webc:for="(bubble, index) of buzzTalk.bubbles"
      :x-show="`step === ${index}`"
      @html="bubble"
    ></p>
    <!-- Blinking dots: tap anywhere to keep going -->
    <span class="more" x-show="!isLast" aria-hidden="true">...</span>
  </div>

  <buzz-mascot class="about-buzz"></buzz-mascot>

  <p class="tap-hint" x-show="step === 0" aria-hidden="true">Tap to continue</p>

  <a
    class="talk-done"
    x-show="isLast"
    :href="buzzTalk.lastLink"
    @text="buzzTalk.lastButton"
  ></a>

  <p class="credits">
    Based on <a href="https://github.com/Gyanreyer/open-spelling-bee">Open Spelling Bee</a>
    by Ryan Geyer, MIT license.
  </p>
</main>

<script webc:bucket="alpine">
  Alpine.data("buzzTalk", () => ({
    step: 0,
    total: 0,
    init() {
      this.total = this.$el.querySelectorAll(".bubble p").length;
    },
    get isLast() {
      return this.step === this.total - 1;
    },
    // A tap anywhere on the screen moves to Buzz's next line
    // (taps on links, like the tabs or the last button, just follow the link)
    next(event) {
      if (event?.target.closest("a")) return;
      if (!this.isLast) this.step++;
    },
  }));
</script>

<style>
  /* The whole screen is tappable */
  body:has(.about) {
    cursor: pointer;
  }

  .about {
    max-width: 25rem;
    margin: 0 auto;
    -webkit-tap-highlight-color: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .about h1 {
    align-self: flex-start;
    font-size: 1.6rem;
    margin: 0.5rem 0 1.25rem;
  }

  /* The speech bubble, with a little tail pointing down at Buzz */
  .bubble {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    min-height: 7.5rem;
    padding: 1.1rem 1.25rem;
    border-radius: 1.25rem;
    background: var(--surface);
    border: 2px solid var(--yellow);
  }

  .bubble::after {
    content: "";
    position: absolute;
    bottom: -0.75rem;
    left: 50%;
    width: 1.25rem;
    height: 1.25rem;
    background: var(--surface);
    border-right: 2px solid var(--yellow);
    border-bottom: 2px solid var(--yellow);
    transform: translateX(-50%) rotate(45deg);
  }

  .bubble p {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.45;
  }

  .about-buzz {
    width: 12rem;
    margin: 1.5rem auto 0.75rem;
  }

  /* The "..." at the end of each line, pulsing to say "tap for more" */
  .more {
    display: block;
    text-align: right;
    margin-top: 0.25rem;
    color: var(--yellow);
    font-size: 1.4rem;
    font-weight: bold;
    line-height: 0.5;
    letter-spacing: 0.1em;
    animation: more-pulse 1.2s ease-in-out infinite;
  }

  @keyframes more-pulse {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 1;
    }
  }

  .tap-hint {
    margin: 0;
    color: var(--line);
    font-size: 0.85rem;
  }

  .talk-done {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 0.85rem;
    border-radius: 0.75rem;
    background: var(--gradient);
    color: var(--text-on-yellow);
    font-size: 1.05rem;
    font-weight: bold;
    text-align: center;
    text-decoration: none;
  }

  .credits {
    margin-top: 2.5rem;
    font-size: 0.8rem;
    color: var(--line);
    text-align: center;
  }

  .credits a {
    color: var(--line);
  }
</style>
