---
layout: base.webc
title: What is this?
tab: home
---

<!--
  Buzz explains the game, one speech bubble at a time, typing each line out
  as if he's saying it. Tap to finish a line early, then tap for the next.
  The words live in src/_data/buzzTalk.json: edit them there, not here.
-->
<main
  class="about"
  x-data="buzzTalk"
  x-cloak
  x-on:click.window="next($event)"
  x-on:keydown.window.enter="next()"
  x-on:keydown.window.space.prevent="next()"
>
  <!-- No visible title; screen readers still hear it -->
  <h1 class="visually-hidden">What is this?</h1>

  <div class="bubble">
    <p
      webc:for="(bubble, index) of buzzTalk.bubbles"
      :x-show="`step === ${index}`"
      @html="bubble"
    ></p>
    <!-- Blinking dots: tap anywhere to keep going -->
    <span class="more" x-show="!isLast && !isTyping" aria-hidden="true">...</span>
  </div>

  <buzz-mascot class="about-buzz"></buzz-mascot>

  <!-- Same height whatever shows here, so Buzz doesn't jump around -->
  <div class="talk-footer">
    <p class="tap-hint" x-show="step === 0" aria-hidden="true">Tap to continue</p>

    <a
      class="talk-done"
      x-show="isLast && !isTyping"
      :href="buzzTalk.lastLink"
      @text="buzzTalk.lastButton"
    ></a>
  </div>

</main>

<script webc:bucket="alpine">
  // How fast Buzz "speaks": milliseconds per letter
  const TYPING_SPEED = 30;

  Alpine.data("buzzTalk", () => ({
    step: 0,
    total: 0,
    isTyping: false,
    lines: [],

    init() {
      this.lines = [...this.$el.querySelectorAll(".bubble p")];
      this.total = this.lines.length;
      // Remember each line's full text (with any bold or italics)
      this.lines.forEach((line) => (line.dataset.full = line.innerHTML));
      this.typeLine();
    },

    get isLast() {
      return this.step === this.total - 1;
    },

    // A tap anywhere on the screen finishes the line being typed, or moves
    // to Buzz's next line (taps on links, like the tabs, just follow the link)
    next(event) {
      if (event?.target.closest("a")) return;
      if (this.isTyping) {
        this.finishLine();
      } else if (!this.isLast) {
        this.step++;
        this.typeLine();
      }
    },

    // Types the current line out one letter at a time
    typeLine() {
      const line = this.lines[this.step];
      const fullHtml = line.dataset.full;

      // People who turn off animations on their phone get the whole line
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        line.innerHTML = fullHtml;
        return;
      }

      const totalLetters = textLength(fullHtml);
      let shown = 0;
      line.innerHTML = "";
      this.isTyping = true;
      clearInterval(this.timer);
      this.timer = setInterval(() => {
        shown++;
        line.innerHTML = firstLetters(fullHtml, shown);
        if (shown >= totalLetters) this.finishLine();
      }, TYPING_SPEED);
    },

    finishLine() {
      clearInterval(this.timer);
      this.lines[this.step].innerHTML = this.lines[this.step].dataset.full;
      this.isTyping = false;
    },
  }));

  // How many letters are in some HTML, not counting its tags
  function textLength(html) {
    const box = document.createElement("div");
    box.innerHTML = html;
    return box.textContent.length;
  }

  // The HTML cut off after `count` letters, keeping tags like <strong> whole
  function firstLetters(html, count) {
    const box = document.createElement("div");
    box.innerHTML = html;
    let left = count;
    const walker = document.createTreeWalker(box, NodeFilter.SHOW_TEXT);
    let node;
    while ((node = walker.nextNode())) {
      if (left >= node.textContent.length) {
        left -= node.textContent.length;
      } else {
        node.textContent = node.textContent.slice(0, left);
        left = 0;
      }
    }
    return box.innerHTML;
  }
</script>

<style>
  /* The whole screen is tappable */
  body:has(.about) {
    cursor: pointer;
    /* Tapping quickly shouldn't select (and highlight) Buzz's words */
    -webkit-user-select: none;
    user-select: none;
  }

  /* Buzz and his bubble sit in the middle of the screen, a little low */
  .about {
    max-width: 25rem;
    min-height: calc(100dvh - 8rem - env(safe-area-inset-top));
    margin: 0 auto;
    padding-top: 3rem;
    box-sizing: border-box;
    justify-content: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* The speech bubble, with a little tail pointing down at Buzz */
  .bubble {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    min-height: 7.5rem;
    padding: 1.1rem 1.25rem;
    border-radius: 1.25rem;
    background: var(--surface);
    border: 2px solid var(--yellow);
  }

  .bubble::after {
    content: "";
    position: absolute;
    bottom: -0.75rem;
    left: 50%;
    width: 1.25rem;
    height: 1.25rem;
    background: var(--surface);
    border-right: 2px solid var(--yellow);
    border-bottom: 2px solid var(--yellow);
    transform: translateX(-50%) rotate(45deg);
  }

  .bubble p {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.45;
  }

  .about-buzz {
    width: 12rem;
    margin: 1.5rem auto 0.75rem;
  }

  /* The "..." at the end of each line, pulsing to say "tap for more" */
  .more {
    display: block;
    text-align: right;
    margin-top: 0.25rem;
    color: var(--yellow);
    font-size: 1.4rem;
    font-weight: bold;
    line-height: 0.5;
    letter-spacing: 0.1em;
    animation: more-pulse 1.2s ease-in-out infinite;
  }

  @keyframes more-pulse {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 1;
    }
  }

  .talk-footer {
    width: 100%;
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tap-hint {
    margin: 0;
    color: var(--line);
    font-size: 0.85rem;
  }

  .talk-done {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 0.85rem;
    border-radius: 0.75rem;
    background: var(--gradient);
    color: var(--text-on-yellow);
    font-size: 1.05rem;
    font-weight: bold;
    text-align: center;
    text-decoration: none;
  }
</style>
